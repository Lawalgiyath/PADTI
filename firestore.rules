rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Marketplace
    match /marketplace/{listingId} {
      allow read: if true; // Public listings
      allow write: if isAuthenticated(); // Restrict to specific roles in app logic
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }
  }
}